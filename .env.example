# Supabase connection for the Vite app.
# Copy this file to `.env.local` and fill in your project's values.
# For local development, run `bunx supabase start` and use the values it prints.
# Never put a service_role / secret key here; the browser must only use the
# publishable (anon) key. Row Level Security is the security boundary.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
