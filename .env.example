# Environment variables for the Vite app (Supabase connection).
#
# The browser only ever uses the publishable (anon) key — never the
# service_role / secret key. Row Level Security is the security boundary.
#
# Local development:
#   1. cp .env.example .env.local
#   2. Run `bunx supabase start` and copy the printed API URL + anon key.
#   3. `bun run dev` loads .env.local (git-ignored).
#
# Production / Preview (Vercel):
#   Set VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY under
#   Vercel → Project → Settings → Environment Variables. Do NOT commit them.
#   Vite bakes VITE_* values in at build time, so redeploy after changing them.
#
# Vite modes: `bun run dev` = development, `bun run build` = production.
# Files are merged in this order (later wins):
#   .env  <  .env.local  <  .env.[mode]  <  .env.[mode].local
# Only `VITE_`-prefixed variables are exposed to the client.

# Local development defaults (hosted values live in Vercel, not here).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
